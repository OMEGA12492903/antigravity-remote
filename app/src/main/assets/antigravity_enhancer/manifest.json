{
  "manifest_version": 2,
  "name": "Antigravity Mobile Enhancer",
  "version": "1.0.0",
  "description": "Mobile ergonomic enhancements and native bridge for Antigravity Remote",
  "browser_specific_settings": {
    "gecko": {
      "id": "antigravity-enhancer@omegax.local"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://antigravity.google.com/*",
        "https://antigravity.google/*"
      ],
      "css": ["enhancer.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

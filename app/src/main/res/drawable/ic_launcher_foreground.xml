<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Subtle orbital glow ring -->
    <path
        android:pathData="M24,62 C28,74 44,80 62,74 C76,69 86,58 84,48"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="24"
                android:startY="62"
                android:endX="84"
                android:endY="48"
                android:type="linear">
                <item android:color="#4285F4" android:offset="0.0" />
                <item android:color="#A142F4" android:offset="0.55" />
                <item android:color="#24C1E0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized ascending Antigravity 'A' chevron -->
    <path
        android:pathData="M54,24 L76,74 L65.5,74 L54,47.5 L42.5,74 L32,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="24"
                android:endX="76"
                android:endY="74"
                android:type="linear">
                <item android:color="#8AB4F8" android:offset="0.0" />
                <item android:color="#669DF6" android:offset="0.45" />
                <item android:color="#C58AF9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Floating core spark / remote beacon dot -->
    <path
        android:pathData="M54,57 m-4.5,0 a4.5,4.5 0,1 1,9 0 a4.5,4.5 0,1 1,-9 0"
        android:fillColor="#34D399" />
</vector>
